{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calm Mood Desktop",
  "version": "0.4.2",
  "identifier": "com.arsen.calm-mood",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calm Mood Desktop",
        "width": 800,
        "height": 600,
        "decorations": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Arsen G.",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "assets/sounds/*": "sounds/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "both",
        "sidebarImage": "assets/sidebar-image.bmp",
        "headerImage": "assets/header-image.bmp",
        "installerIcon": "assets/installer.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ArsenGabrielyan/calm-mood-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQUM2RTQ5QjlERjlEQ0IKUldUTG5kKzVTVzZzZ2M5ZmNYcUU0UjU1bVZNTGdueE1qaEdOSlNJUllHZzg5cndiVnNvT1U4ZnEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
